{
  "manifest_version": 3,
  "name": "ReelDash Companion",
  "version": "1.0.0",
  "description": "1-Click Save Instagram Reels directly to your ReelDash Library with high quality video streaming.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReelDash Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
