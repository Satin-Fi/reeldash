# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ── Supabase ────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── App URL (for webhook internal calls) ────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In Vercel production: https://reeldash-nine.vercel.app

# ── Instagram / Meta Webhook ─────────────────────────────────────
# Any random string you choose — must match what you set in Meta Developer Console
INSTAGRAM_VERIFY_TOKEN=reeldash_webhook_2026

# Instagram Page Access Token from Meta Developer Console
# Required to send DM replies back to users
INSTAGRAM_PAGE_ACCESS_TOKEN=your_page_access_token_here

# ── Cloudflare Worker (existing) ─────────────────────────────────
# Already deployed to: https://reeldash-ig-proxy.reeldash-ig-proxy.workers.dev
